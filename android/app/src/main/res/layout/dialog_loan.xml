<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_loan_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="申請借用設備"
        android:textColor="@color/text_light"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_loan_student_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="學號 (如: 110590001)"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_secondary" />

    <EditText
        android:id="@+id/et_loan_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="姓名"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_secondary" />

    <EditText
        android:id="@+id/et_loan_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="聯絡電話 (09xxxxxxxx)"
        android:inputType="phone"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_secondary" />

    <EditText
        android:id="@+id/et_loan_purpose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="借用用途"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_secondary" />

</LinearLayout>
